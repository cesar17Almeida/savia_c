# Credenciales OTAA del dispositivo TTN. Copia este fichero a `.env` y rellena los
# valores reales:  cp .env.example .env
#
# `.env` esta en .gitignore: NO se commitea nunca. El Makefile lo carga y se los
# pasa a CMake, que los inyecta como -DSAVIA_LORA_*. Sin `.env` el firmware compila
# con placeholders a cero: arranca y funciona, pero no se une a una red real.
#
# Se sacan de la consola de TTN (eu1) -> aplicacion `savia` -> el end device.

LORA_DEV_EUI=
LORA_APP_EUI=0000000000000000
LORA_APP_KEY=
