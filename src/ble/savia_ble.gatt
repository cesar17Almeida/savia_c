// Savia BLE GATT database -- same contract as savia_py (see savia/protocol.h),
// so TerraLink (config) and Tobías' dashboard (client) connect unchanged.
// Compiled to savia_ble.h by the Pico SDK (pico_btstack_make_gatt_header).

PRIMARY_SERVICE, GAP_SERVICE
// DYNAMIC: served from cfg->ble_name so a connected central reads the same name
// it saw advertised (which is app-editable), not a baked-in "Savia".
CHARACTERISTIC, GAP_DEVICE_NAME, READ | DYNAMIC, "Savia"

PRIMARY_SERVICE, GATT_SERVICE
CHARACTERISTIC, GATT_DATABASE_HASH, READ,

// --- Savia service (5a71a000-...-0001) ---
PRIMARY_SERVICE, 5A71A000-0000-0000-0000-000000000001
// status (0010): {v, fw, uptime_s, last_sync_ms, weather_updated_ms} -- read.
CHARACTERISTIC, 5A71A000-0000-0000-0000-000000000010, READ | DYNAMIC,
// time_sync (0011): {v, op:"set", ms} -- write.
CHARACTERISTIC, 5A71A000-0000-0000-0000-000000000011, WRITE | DYNAMIC,
// weather (0012): {v, op:"upd", data:{...}} -- write.
CHARACTERISTIC, 5A71A000-0000-0000-0000-000000000012, WRITE | DYNAMIC,
// config (0013): read = snapshot {v, device, name, sleep_s, deep_sleep, capture_s,
//   daily_hour, mock, log_level, wake_gpio, sensors}; write = patch (any of those
//   fields); notify = ack {v, op:"config_ok"/"config_err"}.
CHARACTERISTIC, 5A71A000-0000-0000-0000-000000000013, READ | WRITE | NOTIFY | DYNAMIC,
CLIENT_CHARACTERISTIC_CONFIGURATION,
// auth (0014): read = {v, prov, authed, nonce}; write = {op:"setpw"/"auth"/"chgpw", ...}.
CHARACTERISTIC, 5A71A000-0000-0000-0000-000000000014, READ | WRITE | DYNAMIC,
// pinmap (0015): read = {v, pins:[{gpio, state, reason, caps, port?}]} -- GPIO
// inventory so the app offers only assignable pins (free / not system-reserved).
CHARACTERISTIC, 5A71A000-0000-0000-0000-000000000015, READ | DYNAMIC,
// data_request (0020): {v, op:"get"/"count", kind, from?, to?, limit?} -- write.
CHARACTERISTIC, 5A71A000-0000-0000-0000-000000000020, WRITE | DYNAMIC,
// data_response (0021): {v, op:"chunk", s, t, eof, p} -- notify (chunked).
CHARACTERISTIC, 5A71A000-0000-0000-0000-000000000021, NOTIFY | DYNAMIC,
CLIENT_CHARACTERISTIC_CONFIGURATION,
// blob_control (0030): firmware/model OTA. STUB -- present so clients that
// discover the full contract (TerraLink) don't fail; not implemented yet.
CHARACTERISTIC, 5A71A000-0000-0000-0000-000000000030, WRITE | NOTIFY | DYNAMIC,
CLIENT_CHARACTERISTIC_CONFIGURATION,
